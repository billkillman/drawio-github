<mxCell id="n1" value="Batch hebdo — flux de traitement (horizons S+3 et S+4)" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#12263a;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1200" height="28" as="geometry"/></mxCell>
<mxCell id="n2" value="44 modèles (1 par file) chargés une seule fois · chaque modèle est multi-horizon : 1 predict par file → S+3 et S+4" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#5b6b7a;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1300" height="22" as="geometry"/></mxCell>
<mxCell id="n3" value="&lt;b style='color:#d97706;font-size:12px;'&gt;COS ML Registry&lt;/b&gt;&lt;br&gt;&lt;span style='color:#3d4a57;font-size:9.5px;font-family:Courier New;'&gt;manifest/current.json → vN&lt;/span&gt;&lt;br&gt;&lt;span style='color:#3d4a57;font-size:9.5px;'&gt;44 modèles = 1 par file&lt;/span&gt;&lt;br&gt;&lt;span style='color:#3d4a57;font-size:9.5px;'&gt;chacun multi-horizon (S+3, S+4)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fdf0e3;strokeColor=#d97706;strokeWidth=1.6;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="230" height="118" as="geometry"/></mxCell>
<mxCell id="n4" value="&lt;b style='color:#0e7490;font-size:12px;'&gt;COS métier&lt;/b&gt;&lt;br&gt;&lt;span style='color:#3d4a57;font-size:9.5px;font-family:Courier New;'&gt;historique_interactions.parquet&lt;/span&gt;&lt;br&gt;&lt;span style='color:#3d4a57;font-size:9.5px;'&gt;calendrier · événements&lt;/span&gt;&lt;br&gt;&lt;span style='color:#3d4a57;font-size:9.5px;'&gt;referentiel_files (44 actives)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e0f2f4;strokeColor=#0e7490;strokeWidth=1.6;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="230" height="118" as="geometry"/></mxCell>
<mxCell id="n5" value="&lt;b style='color:#8b5cf6;font-size:12px;'&gt;Gitlab · config&lt;/b&gt;&lt;br&gt;&lt;span style='color:#3d4a57;font-size:9.5px;font-family:Courier New;'&gt;run_profile = hebdo&lt;/span&gt;&lt;br&gt;&lt;span style='color:#3d4a57;font-size:9.5px;font-family:Courier New;'&gt;echeances.yml[hebdo] = {S+3,S+4}&lt;/span&gt;&lt;br&gt;&lt;span style='color:#3d4a57;font-size:9.5px;font-family:Courier New;'&gt;horizons.yml → histo_semaines&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f1ecfd;strokeColor=#8b5cf6;strokeWidth=1.6;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="1130" y="100" width="230" height="118" as="geometry"/></mxCell>
<mxCell id="n6" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#5b6b7a;strokeWidth=2;fontColor=#5b6b7a;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="342" width="70" height="36" as="geometry"/></mxCell>
<mxCell id="n7" value="&lt;b style='font-size:13px;color:#12263a'&gt;Charger les modèles&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:Courier New;color:#d97706;font-size:10px'&gt;load_models() · une seule fois&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#3d4a57'&gt;Résout le manifest → bundle vN&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#3d4a57'&gt;Charge les 44 modèles en mémoire&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#3d4a57'&gt;→ gardés pour TOUT le run&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fdf0e3;strokeColor=#d97706;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=48;spacingTop=4;shadow=1;" vertex="1" parent="1"><mxGeometry x="130" y="300" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="n8" value="1" style="ellipse;html=1;fillColor=#d97706;strokeColor=none;fontColor=#fff;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="140" y="310" width="30" height="30" as="geometry"/></mxCell>
<mxCell id="n9" value="&lt;b style='font-size:13px;color:#12263a'&gt;Sourcer les données&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:Courier New;color:#0e7490;font-size:10px'&gt;source_data() · snapshot horodaté&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#3d4a57'&gt;Historique + calendrier + événements&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#3d4a57'&gt;Fenêtre = histo_semaines max(S+3,S+4)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#3d4a57'&gt;→ run rejouable à l'identique&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#e0f2f4;strokeColor=#0e7490;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=48;spacingTop=4;shadow=1;" vertex="1" parent="1"><mxGeometry x="450" y="300" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="n10" value="2" style="ellipse;html=1;fillColor=#0e7490;strokeColor=none;fontColor=#fff;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="310" width="30" height="30" as="geometry"/></mxCell>
<mxCell id="n11" value="&lt;b style='font-size:13px;color:#12263a'&gt;Préparer les features&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:Courier New;color:#3b6fb5;font-size:10px'&gt;preprocess()&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#3d4a57'&gt;Nettoyage (creux réels, manquants)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#3d4a57'&gt;Features calendaires + lags&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#3d4a57'&gt;→ une matrice X par file (44)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#e9f0f9;strokeColor=#3b6fb5;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=48;spacingTop=4;shadow=1;" vertex="1" parent="1"><mxGeometry x="770" y="300" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="n12" value="3" style="ellipse;html=1;fillColor=#3b6fb5;strokeColor=none;fontColor=#fff;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="310" width="30" height="30" as="geometry"/></mxCell>
<mxCell id="n13" value="⟳ pour chaque file (×44)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2e8b57;strokeWidth=1.6;dashed=1;dashPattern=7 5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=11;fontColor=#2e8b57;" vertex="1" parent="1"><mxGeometry x="1080" y="270" width="420" height="190" as="geometry"/></mxCell>
<mxCell id="n14" value="&lt;b style='font-size:13px;color:#12263a'&gt;Prédire&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:Courier New;color:#2e8b57;font-size:10px'&gt;models[file].predict(X_file) · 1 appel&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#3d4a57'&gt;Le modèle de la file est déjà en mémoire&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#3d4a57'&gt;1 appel → S+3 ET S+4 d'un coup (multi-horizon)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#3d4a57'&gt;→ vol_prevu au pas T15 (672 points / horizon)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#eaf5ee;strokeColor=#2e8b57;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=48;spacingTop=4;shadow=1;" vertex="1" parent="1"><mxGeometry x="1100" y="300" width="380" height="120" as="geometry"/></mxCell>
